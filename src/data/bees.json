  "species": "insularis",
  "common_names": [
   "Indiscriminate cuckoo bumble bee"
  ],
  "subgenus": "psithyrus",
  "cuckoo": true,
  "active_start": "May",
  "active_end": "September",
  "confused_with": [
   "flavidus",
   "citrinus"
  ],
  "description": "A cuckoo bumble bee that uses the nests of several different host species, which is where its name comes from. The thorax is mostly pale yellow and the abdomen is black with yellow along the sides. It has no pollen baskets.",
