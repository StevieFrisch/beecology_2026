 {
  "id": "ne-sandersoni",
  "species": "sandersoni",
  "common_names": [
   "Sanderson's bumble bee"
  ],
  "subgenus": "pyrobombus",
  "tongue_length": "short",
  "active_start": "May",
  "active_end": "September",
  "confused_with": [
   "vagans",
   "perplexus"
  ],
  "description": "A small, northern bumble bee. The thorax is yellow with a black spot between the wings, and the first two abdomen segments are yellow while the rest of the abdomen is black. It looks almost identical to the half-black bumble bee; a shorter face is the clearest difference.",
  "image": "https://inaturalist-open-data.s3.amazonaws.com/photos/28292262/medium.jpg",
  "image_credit": "Mark Olivier",
  "image_license": "CC BY-NC",
  "image_license_url": "https://creativecommons.org/licenses/by-nc/4.0/"
 },
 {
  "id": "ne-rufocinctus",
  "species": "rufocinctus",
  "common_names": [
   "Red-belted bumble bee"
  ],
  "subgenus": "cullumanobombus",
  "tongue_length": "short",
  "active_start": "May",
  "active_end": "September",
  "confused_with": [
   "ternarius",
   "bimaculatus"
  ],
  "description": "One of the most variable bumble bees in color. Many individuals have a reddish or orange band partway down the abdomen with yellow on either side, but some are mostly yellow or mostly black. Uncommon in New England, where it is found mainly in the north.",
  "image": "https://inaturalist-open-data.s3.amazonaws.com/photos/85728033/medium.jpeg",
  "image_credit": "Denis Doucet",
  "image_license": "CC BY-NC",
  "image_license_url": "https://creativecommons.org/licenses/by-nc/4.0/"
 },
 {
  "id": "ne-auricomus",
  "species": "auricomus",
  "common_names": [
   "Black-and-gold bumble bee"
  ],
  "subgenus": "bombias",
  "tongue_length": "long",
  "active_start": "May",
  "active_end": "September",
  "confused_with": [
   "pensylvanicus"
  ],
  "description": "A large bumble bee with a crisp black band across the thorax between the wings and yellow on the second and third abdominal segments; the first segment is mostly black. It is rare in New England and easily confused with the American bumble bee.",
  "image": "https://inaturalist-open-data.s3.amazonaws.com/photos/19348416/medium.jpeg",
  "image_credit": "Mark Nofsinger",
