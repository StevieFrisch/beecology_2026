 {
  "id": "32101a07-4655-486c-bfc5-e1d612beef45",
  "species": "pensylvanicus",
  "common_names": [
   "American bumble bee"
  ],
  "description": "This bumble bee has a mostly yellow abdomen. The bottom of the abdomen is always black and the first segment at the top of the abdomen is often black as well. The thorax is typically dark, either being all black or having a distinct black band surrounded by gray coloring.",
