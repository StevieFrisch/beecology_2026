 },
 {
  "id": "ne-citrinus",
  "species": "citrinus",
  "common_names": [
   "Lemon cuckoo bumble bee"
  ],
  "subgenus": "psithyrus",
  "cuckoo": true,
  "active_start": "June",
  "active_end": "September",
  "confused_with": [
   "impatiens",
   "bimaculatus"
  ],
  "description": "A cuckoo bumble bee that takes over the nests of other bumble bees, including the common eastern bumble bee. Females are mostly black, with a yellow thorax marked by a black dot and usually a single yellow band on the third abdominal segment. Like other cuckoos it has no pollen baskets on its hind legs, and its abdomen is shinier and less hairy than a nest-building bee's.",
  "image": "https://inaturalist-open-data.s3.amazonaws.com/photos/12182677/medium.jpg",
  "image_credit": "Heather Holm",
  "image_license": "CC BY-NC",
  "image_license_url": "https://creativecommons.org/licenses/by-nc/4.0/",
  "tongue_length": null
 },
 {
  "id": "ne-ashtoni",
  "species": "ashtoni",
  "common_names": [
   "Ashton's cuckoo bumble bee"
  ],
  "subgenus": "psithyrus",
  "cuckoo": true,
  "active_start": "May",
  "active_end": "August",
  "confused_with": [
   "terricola",
   "affinis"
  ],
  "description": "A cuckoo bumble bee that depends on the nests of the rusty-patched and yellow-banded bumble bees, so it has declined along with them. Mostly black with yellow on the front of the thorax and pale patches toward the tip of the abdomen. It has no pollen baskets.",
  "image": "https://inaturalist-open-data.s3.amazonaws.com/photos/521629856/medium.jpg",
  "image_credit": "Denis Doucet",
  "image_license": "CC BY-NC",
  "image_license_url": "https://creativecommons.org/licenses/by-nc/4.0/",
  "tongue_length": null,
  "image_source_url": "https://www.inaturalist.org/observations/289991416"
 },
 {
  "id": "ne-flavidus",
  "species": "flavidus",
  "common_names": [
   "Fernald's cuckoo bumble bee"
  ],
  "subgenus": "psithyrus",
  "cuckoo": true,
  "active_start": "June",
  "active_end": "September",
  "confused_with": [
   "insularis"
  ],
  "description": "A cuckoo bumble bee of northern and mountain areas. Its coloring varies; females usually have a yellow thorax with a large black dot and yellow bands on the first and third abdominal segments. It has no pollen baskets and is best confirmed by an expert.",
  "image": "https://inaturalist-open-data.s3.amazonaws.com/photos/18571510/medium.jpg",
  "image_credit": "leif_richardson",
